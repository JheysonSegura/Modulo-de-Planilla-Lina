# Postgres
POSTGRES_USER=nomina
POSTGRES_PASSWORD=nomina
POSTGRES_DB=nomina
POSTGRES_PORT=5432

# Rol de aplicación (bajo privilegio, para que RLS se aplique de verdad;
# ver backend/alembic/versions/0006_app_role_rls.py)
POSTGRES_APP_USER=nomina_app
POSTGRES_APP_PASSWORD=change-me

# Backend
ENVIRONMENT=development
BACKEND_PORT=8000
JWT_SECRET_KEY=change-me-generate-a-random-secret
# Orígenes permitidos para CORS (el frontend corre en un puerto
# distinto incluso en desarrollo) -- separados por coma si hay más de uno.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
FRONTEND_PORT=3000
NUXT_PUBLIC_API_BASE=http://localhost:8000
