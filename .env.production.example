# Plantilla para producción -- usar con docker-compose.prod.yml:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# NUNCA reutilizar los valores de .env.example/.env de desarrollo acá.
# Generar secretos nuevos, por ejemplo:
#   JWT_SECRET_KEY: openssl rand -hex 32
#   POSTGRES_PASSWORD / POSTGRES_APP_PASSWORD: openssl rand -base64 24

# Postgres (sin POSTGRES_PORT: docker-compose.prod.yml no publica el
# puerto de la base de datos al host -- solo el backend la alcanza por
# la red interna de Compose. Ver auditoría de seguridad 2026-08-25, A4).
POSTGRES_USER=nomina
POSTGRES_PASSWORD=CAMBIAR-generar-secreto-real

# Rol de aplicación (bajo privilegio, para que RLS se aplique de verdad;
# ver backend/alembic/versions/0006_app_role_rls.py)
POSTGRES_DB=nomina
POSTGRES_APP_USER=nomina_app
POSTGRES_APP_PASSWORD=CAMBIAR-generar-secreto-real

# Backend (ENVIRONMENT=production va fijo en docker-compose.prod.yml, no
# hace falta repetirlo acá -- ver Settings._rechazar_secretos_de_desarrollo_en_produccion
# en backend/app/core/config.py: si JWT_SECRET_KEY queda en el valor de
# desarrollo, la app se niega a arrancar).
# BACKEND_PORT ya NO se publica a 0.0.0.0 -- el proxy (ver más abajo) es
# la única puerta de entrada pública; esto solo queda en loopback para
# debug puntual vía túnel SSH (docker-compose.prod.yml).
BACKEND_PORT=8000
JWT_SECRET_KEY=CAMBIAR-generar-secreto-real
# Dominio(s) real(es) del frontend en producción -- nunca localhost acá.
CORS_ALLOWED_ORIGINS=https://tu-dominio-real.com

# Frontend (FRONTEND_PORT: mismo criterio que BACKEND_PORT arriba)
FRONTEND_PORT=3000
NUXT_PUBLIC_API_BASE=https://api.tu-dominio-real.com

# Reverse proxy con TLS automático (servicio "proxy", Caddy -- ver
# AUDITORIA-SEGURIDAD-2026-08-25.md B6). Deben apuntar por DNS (registro
# A/AAAA) a la IP pública de este servidor ANTES de levantar el stack,
# o Caddy no puede emitir el certificado de Let's Encrypt. Usar los
# mismos dominios que CORS_ALLOWED_ORIGINS/NUXT_PUBLIC_API_BASE arriba,
# sin el esquema "https://" (Caddy lo agrega solo).
DOMINIO_FRONTEND=tu-dominio-real.com
DOMINIO_API=api.tu-dominio-real.com

# Backups (servicio "backup", ver AUDITORIA-SEGURIDAD-2026-08-25.md M6).
# Opcionales -- si se omiten, backup_loop.sh usa 14 días / 24h por defecto.
BACKUP_RETENCION_DIAS=14
BACKUP_INTERVALO_SEGUNDOS=86400
