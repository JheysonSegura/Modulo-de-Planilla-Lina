FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Dependencias de sistema de WeasyPrint (Fase 16: generación de PDF)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    libffi-dev \
    shared-mime-info \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Auditoría de seguridad 2026-08-25 (hallazgo A4): a diferencia del
# Dockerfile de desarrollo (que corre como root porque el bind-mount
# ./backend:/app de docker-compose.yml, sobre una carpeta sincronizada
# con OneDrive en este equipo, no tolera un usuario no privilegiado),
# esta imagen de producción copia el código en build-time: sin
# bind-mount, sin conflicto de permisos.
RUN useradd --create-home --shell /usr/sbin/nologin appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# Sin --reload (no aplica sin bind-mount) y con varios workers -- ajustar
# el número según CPU disponible en el servidor real.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
